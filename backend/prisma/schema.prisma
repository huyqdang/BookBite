generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Users ──────────────────────────────────────────────────────────────────

model User {
  id           String   @id @default(uuid()) @db.Uuid
  email        String?  @unique
  passwordHash String?  @map("password_hash")
  appleId      String?  @unique @map("apple_id")
  googleId     String?  @unique @map("google_id")
  displayName  String   @map("display_name")
  avatarUrl    String?  @map("avatar_url")
  role         Role     @default(USER)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  preferences UserPreference?
  bookmarks   Bookmark[]
  likes       Like[]
  storyViews  StoryView[]
  dailyFeeds  DailyFeed[]

  @@map("users")
}

enum Role {
  USER
  ADMIN
}

// ─── User Preferences ──────────────────────────────────────────────────────

model UserPreference {
  id                   String   @id @default(uuid()) @db.Uuid
  userId               String   @unique @map("user_id") @db.Uuid
  bookCategories       String[] @map("book_categories")
  preferredReadingTimes Int[]    @map("preferred_reading_times")
  timezone             String   @default("UTC") // IANA timezone, e.g. "America/New_York"
  fontFamily           String   @default("system") @map("font_family") // e.g. "georgia", "palatino", "newYork"
  fontSize             Int      @default(18) @map("font_size") // reading font size in points (14–28)
  onboardingCompleted  Boolean  @default(false) @map("onboarding_completed")
  updatedAt            DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_preferences")
}

// ─── Books ──────────────────────────────────────────────────────────────────

model Book {
  id           String     @id @default(uuid()) @db.Uuid
  title        String
  author       String     @default("Unknown")
  coverUrl     String?    @map("cover_url")
  purchaseLink String?    @map("purchase_link")
  sourceFile   String?    @unique @map("source_file")
  isbn         String?    // ISBN-10 for affiliate links
  categories   String[]
  tier         Int        @default(2) // 1=curated top 200, 2=bulk/general, 3=AI-knowledge
  status       BookStatus @default(QUEUED)
  storyCount   Int        @default(0) @map("story_count")
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")

  stories Story[]

  @@index([tier])
  @@map("books")
}

enum BookStatus {
  QUEUED
  PROCESSING
  COMPLETED
  FAILED
}

// ─── Stories ────────────────────────────────────────────────────────────────

model Story {
  id                 String   @id @default(uuid()) @db.Uuid
  bookId             String   @map("book_id") @db.Uuid
  title              String
  content            String   @db.Text
  summary            String?  @db.Text
  readingTimeMinutes Int      @map("reading_time_minutes")
  categories         String[]
  tone               String?
  styleSeed          String?  @map("style_seed")
  storyGroupId       String?  @map("story_group_id")
  likeCount          Int      @default(0) @map("like_count")
  bookmarkCount      Int      @default(0) @map("bookmark_count")
  viewCount          Int      @default(0) @map("view_count")
  createdAt          DateTime @default(now()) @map("created_at")

  book       Book        @relation(fields: [bookId], references: [id], onDelete: Cascade)
  bookmarks  Bookmark[]
  likes      Like[]
  storyViews StoryView[]

  @@index([bookId])
  @@index([readingTimeMinutes])
  @@index([categories])
  @@index([createdAt])
  @@map("stories")
}

// ─── Bookmarks ──────────────────────────────────────────────────────────────

model Bookmark {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  storyId   String   @map("story_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  story Story @relation(fields: [storyId], references: [id], onDelete: Cascade)

  @@unique([userId, storyId])
  @@index([userId])
  @@index([storyId])
  @@map("bookmarks")
}

// ─── Likes ──────────────────────────────────────────────────────────────────

model Like {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  storyId   String   @map("story_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  story Story @relation(fields: [storyId], references: [id], onDelete: Cascade)

  @@unique([userId, storyId])
  @@index([userId])
  @@index([storyId])
  @@map("likes")
}

// ─── Story Views (for feed algorithm) ───────────────────────────────────────

model StoryView {
  id             String   @id @default(uuid()) @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  storyId        String   @map("story_id") @db.Uuid
  readPercentage Float    @default(0) @map("read_percentage")
  viewedAt       DateTime @default(now()) @map("viewed_at")

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  story Story @relation(fields: [storyId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([storyId])
  @@index([userId, storyId])
  @@map("story_views")
}

// ─── Daily Feeds (pre-built personalized feeds) ─────────────────────────────

model DailyFeed {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  date         DateTime @db.Date // Calendar date this feed is for
  storyIds     String[] @map("story_ids") // Ordered array of story UUIDs
  totalMinutes Int      @map("total_minutes") // Total reading time in the feed
  storyCount   Int      @map("story_count") // How many stories in the feed
  createdAt    DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@index([userId])
  @@map("daily_feeds")
}

# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/bookbite?schema=public"

# Redis
REDIS_HOST="127.0.0.1"
REDIS_PORT=6379

# JWT
JWT_SECRET="your-jwt-secret-change-me"
JWT_REFRESH_SECRET="your-refresh-secret-change-me"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# AI Providers
ANTHROPIC_API_KEY="your-anthropic-api-key"
OPENAI_API_KEY="your-openai-api-key"

# Server
PORT=3000
NODE_ENV="development"

# Apple Sign-In
APPLE_CLIENT_ID=""
APPLE_TEAM_ID=""
APPLE_KEY_ID=""
APPLE_PRIVATE_KEY=""

# Google Sign-In
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Amazon Affiliate
AMAZON_ASSOCIATE_TAG=""
